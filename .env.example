# Development only. Copy to .env; it is ignored by source control.
BOHOMAN_DATABASE_URL=jdbc:postgresql://localhost:5432/bohoman
BOHOMAN_DATABASE_PORT=5432
BOHOMAN_DATABASE_USER=bohoman_dev
BOHOMAN_DATABASE_PASSWORD=replace-with-a-local-database-password
# Generate: openssl rand -hex 32
BOHOMAN_JWT_SECRET=replace-with-at-least-32-random-bytes
# Google Web OAuth client ID(s) accepted as ID-token audiences, comma separated.
BOHOMAN_GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
BOHOMAN_WEB_ORIGINS=http://localhost:8081
# Only use false for local HTTP development. Production must use HTTPS + true.
BOHOMAN_SECURE_COOKIES=false
PORT=8080
